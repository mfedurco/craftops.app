# Discord OAuth. When either value is missing, the app uses a labeled demo owner.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://127.0.0.1:38471

# Neon PostgreSQL. Leave unset for the local JSON demo store.
# schema.prisma is PostgreSQL-only. Do not put a SQLite URL here.
# DATABASE_URL=postgresql://user:pass@host/craftops?sslmode=require
