# Optional Discord OAuth. Email and password registration works without these.
# When both are set, Discord creates the same kind of user (discordId is optional).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Session signing. Set a long random value in any shared environment.
# If unset, local dev falls back to a built-in development secret.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:38471

# Neon PostgreSQL. Leave unset to use the local JSON store (apps/web/.data/store.json).
# schema.prisma is PostgreSQL-only. Do not put a SQLite URL here.
# DATABASE_URL=postgresql://user:pass@host/craftops?sslmode=require
