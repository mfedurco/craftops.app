// Production schema for Neon PostgreSQL.
// When DATABASE_URL is unset, the web app uses the JSON store in src/lib/demo-repo.ts
// and does not migrate this file. Point DATABASE_URL at Postgres and run
// `pnpm --filter @craftops/web exec prisma db push` to use this schema.
// The Fabric mod never connects here. Ingest is HTTP with x-api-key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  discordId     String?   @unique
  plan          String    @default("free")
  accounts      Account[]
  sessions      Session[]
  servers       Server[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Server {
  id             String          @id @default(cuid())
  name           String
  apiKey         String          @unique @default(uuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  motd           String?
  version        String?
  maxPlayers     Int             @default(40)
  stopped        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  telemetry      Telemetry[]
  auditLogs      AuditLog[]
  playerSessions PlayerSession[]
  commands       RemoteCommand[]

  @@index([ownerId])
}

model Telemetry {
  id            String   @id @default(cuid())
  serverId      String
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  timestamp     DateTime @default(now())
  tps           Float
  mspt          Float
  ramUsedMb     Float
  ramAllocMb    Float
  ramMaxMb      Float
  playersOnline Int
  uptimeSeconds Int      @default(0)

  @@index([serverId, timestamp])
}

model AuditLog {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type      String
  player    String?
  message   String
  x         Float?
  y         Float?
  z         Float?
  dimension String?
  timestamp DateTime @default(now())

  @@index([serverId, timestamp])
  @@index([type])
}

model PlayerSession {
  id        String    @id @default(cuid())
  serverId  String
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  uuid      String
  username  String
  ping      Int       @default(0)
  dimension String?
  x         Float     @default(0)
  y         Float     @default(0)
  z         Float     @default(0)
  health    Float     @default(20)
  food      Int       @default(20)
  operator  Boolean   @default(false)
  online    Boolean   @default(true)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@index([serverId, online])
  @@index([serverId, username])
}

model RemoteCommand {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  action    String
  args      Json
  status    String   @default("pending")
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serverId, status])
}
