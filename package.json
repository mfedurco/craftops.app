{
  "name": "craftops",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @craftops/web dev",
    "build": "pnpm --filter @craftops/web build",
    "dev:widget": "pnpm --filter @craftops/widget dev",
    "lint": "pnpm --filter @craftops/web lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
